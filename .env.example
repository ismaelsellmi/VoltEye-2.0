# Copier en .env (jamais commité) puis relancer docker compose up
# Active l'assistant énergie en mode LLM ; sans clé, il fonctionne en mode hors ligne.
ANTHROPIC_API_KEY=
VOLTEYE_LLM_MODEL=claude-opus-5-5

# Variante : passerelle compatible avec l'API Messages (OpenRouter par exemple).
# Laisser ANTHROPIC_API_KEY vide et indiquer l'identifiant du modèle propre à la passerelle.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# VOLTEYE_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
